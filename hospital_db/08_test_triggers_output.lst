SQL> PROMPT ===== Tests 5 to 7: prescription trigger =====
===== Tests 5 to 7: prescription trigger =====
SQL> DECLARE
  2  	 v_appt    appointment.appointment_id%TYPE;
  3  	 v_before  medicine.stock_qty%TYPE;
  4  	 v_after   medicine.stock_qty%TYPE;
  5  BEGIN
  6  	 SELECT MIN(a.appointment_id) INTO v_appt
  7  	 FROM	appointment a
  8  	 WHERE	NOT EXISTS (SELECT 1 FROM prescribes p
  9  			    WHERE  p.appointment_id = a.appointment_id AND p.medicine_id = 201);
 10  
 11  	 SELECT stock_qty INTO v_before FROM medicine WHERE medicine_id = 201;
 12  	 INSERT INTO prescribes VALUES (v_appt, 201, '500mg twice daily', 3, 6);
 13  	 SELECT stock_qty INTO v_after FROM medicine WHERE medicine_id = 201;
 14  	 DBMS_OUTPUT.PUT_LINE('5. Paracetamol stock: before ' || v_before || ', after prescribing 6 = ' || v_after);
 15  
 16  	 BEGIN
 17  	     INSERT INTO prescribes VALUES (v_appt, 212, '500mg once daily', 3, 3);
 18  	     DBMS_OUTPUT.PUT_LINE('ERROR: expired medicine was allowed');
 19  	 EXCEPTION
 20  	     WHEN OTHERS THEN
 21  		 DBMS_OUTPUT.PUT_LINE('6. Expired medicine		 : ' || SQLERRM);
 22  	 END;
 23  
 24  	 BEGIN
 25  	     INSERT INTO prescribes VALUES (v_appt, 209, '400mg twice daily', 10, 1000);
 26  	     DBMS_OUTPUT.PUT_LINE('ERROR: quantity above stock was allowed');
 27  	 EXCEPTION
 28  	     WHEN OTHERS THEN
 29  		 DBMS_OUTPUT.PUT_LINE('7. Quantity above stock		 : ' || SQLERRM);
 30  	 END;
 31  END;
 32  /
