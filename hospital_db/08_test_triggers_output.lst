SQL> PROMPT ===== Tests 1 to 4: admission and room triggers =====
===== Tests 1 to 4: admission and room triggers =====
SQL> DECLARE
  2  	 v_room     room.room_no%TYPE;
  3  	 v_patient  patient.patient_id%TYPE;
  4  	 v_status   room.status%TYPE;
  5  BEGIN
  6  	 SELECT MIN(room_no) INTO v_room FROM room WHERE status = 'Available';
  7  	 SELECT MIN(patient_id) INTO v_patient FROM patient
  8  	 WHERE	patient_id NOT IN (SELECT patient_id FROM admission WHERE discharge_date IS NULL);
  9  	 DBMS_OUTPUT.PUT_LINE('Using room ' || v_room || ' and patient ' || v_patient);
 10  
 11  	 SELECT status INTO v_status FROM room WHERE room_no = v_room;
 12  	 DBMS_OUTPUT.PUT_LINE('1. Room status before admission	: ' || v_status);
 13  
 14  	 INSERT INTO admission (admission_id, admit_date, discharge_date, reason, patient_id, room_no)
 15  	 VALUES (seq_admission.NEXTVAL, SYSDATE, NULL, 'Trigger test admission', v_patient, v_room);
 16  
 17  	 SELECT status INTO v_status FROM room WHERE room_no = v_room;
 18  	 DBMS_OUTPUT.PUT_LINE('2. Room status after admission	: ' || v_status || '  (trigger 2 set it)');
 19  
 20  	 BEGIN
 21  	     INSERT INTO admission (admission_id, admit_date, discharge_date, reason, patient_id, room_no)
 22  	     VALUES (seq_admission.NEXTVAL, SYSDATE, NULL, 'Should be blocked', v_patient, v_room);
 23  	     DBMS_OUTPUT.PUT_LINE('ERROR: second admission to the same room was allowed');
 24  	 EXCEPTION
 25  	     WHEN OTHERS THEN
 26  		 DBMS_OUTPUT.PUT_LINE('3. Second admission, same room	 : ' || SQLERRM);
 27  	 END;
 28  
 29  	 UPDATE admission SET discharge_date = SYSDATE
 30  	 WHERE	reason = 'Trigger test admission' AND patient_id = v_patient AND discharge_date IS NULL;
 31  
 32  	 SELECT status INTO v_status FROM room WHERE room_no = v_room;
 33  	 DBMS_OUTPUT.PUT_LINE('4. Room status after discharge	: ' || v_status || '  (trigger 3 set it)');
 34  END;
 35  /
Using room 101 and patient 1001                                                                                                                       
1. Room status before admission  : Available                                                                                                          
2. Room status after admission   : Occupied  (trigger 2 set it)                                                                                       
3. Second admission, same room    : ORA-20101: Room 101 is not available (status: Occupied)
ORA-06512: at "SYSTEM.TRG_ADMISSION_CHECK_ROOM", line     
7
ORA-04088: error during execution of trigger 'SYSTEM.TRG_ADMISSION_CHECK_ROOM'                                                                      
4. Room status after discharge   : Available  (trigger 3 set it)                                                                                      

PL/SQL procedure successfully completed.

