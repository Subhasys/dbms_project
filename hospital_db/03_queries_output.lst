SQL> -- ---------------------------------------------------------------------
SQL> -- Q22. SQL FUNCTIONS (date) + CASE: medicines that are expired or
SQL> --      will expire within 6 months of today (depends on SYSDATE)
SQL> -- ---------------------------------------------------------------------
SQL> SELECT medicine_name, expiry_date, stock_qty,
  2  	    TRUNC(expiry_date - SYSDATE) AS days_left,
  3  	    CASE WHEN expiry_date < SYSDATE		  THEN 'EXPIRED'
  4  		 WHEN expiry_date <= ADD_MONTHS(SYSDATE,3) THEN 'EXPIRING SOON'
  5  		 ELSE 'WATCH'
  6  	    END AS shelf_status
  7  FROM   medicine
  8  WHERE  expiry_date <= ADD_MONTHS(SYSDATE, 6)
  9  ORDER  BY expiry_date;

