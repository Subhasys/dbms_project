SQL> -- ---------------------------------------------------------------------
SQL> -- Q14. AGGREGATE + NVL: revenue by payment mode
SQL> --      (bills with no mode yet are shown as 'Not yet paid')
SQL> -- ---------------------------------------------------------------------
SQL> SELECT NVL(payment_mode, 'Not yet paid') AS payment_mode,
  2  	    COUNT(*)			      AS no_of_bills,
  3  	    SUM(total_amount)		      AS total_amount
  4  FROM   v_bill_total
  5  GROUP  BY NVL(payment_mode, 'Not yet paid')
  6  ORDER  BY total_amount DESC;

