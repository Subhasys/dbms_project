SQL> -- ---------------------------------------------------------------------
SQL> -- Q3. JOIN: appointment details with patient and doctor names
SQL> -- ---------------------------------------------------------------------
SQL> SELECT a.appointment_id, a.appt_date, a.appt_time,
  2  	    p.name AS patient_name, d.name AS doctor_name, a.status
  3  FROM   appointment a
  4  	    JOIN patient p ON p.patient_id = a.patient_id
  5  	    JOIN doctor  d ON d.doctor_id  = a.doctor_id
  6  ORDER  BY a.appt_date, a.appt_time;

