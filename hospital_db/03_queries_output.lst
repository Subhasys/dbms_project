SQL> -- ---------------------------------------------------------------------
SQL> -- Q10. AGGREGATE: most prescribed medicines
SQL> -- ---------------------------------------------------------------------
SQL> SELECT m.medicine_name,
  2  	    COUNT(*)	       AS times_prescribed,
  3  	    SUM(pr.quantity)   AS total_quantity
  4  FROM   prescribes pr
  5  	    JOIN medicine m ON m.medicine_id = pr.medicine_id
  6  GROUP  BY m.medicine_name
  7  ORDER  BY times_prescribed DESC, total_quantity DESC;

