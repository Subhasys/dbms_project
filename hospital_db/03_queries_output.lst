SQL> -- ---------------------------------------------------------------------
SQL> -- Q9. AGGREGATE: medicine charge per appointment = SUM(quantity x price)
SQL> --     (matches bill.medicine_charge in the sample data)
SQL> -- ---------------------------------------------------------------------
SQL> SELECT pr.appointment_id, p.name AS patient_name,
  2  	    SUM(pr.quantity * m.unit_price) AS medicine_total
  3  FROM   prescribes pr
  4  	    JOIN medicine    m ON m.medicine_id    = pr.medicine_id
  5  	    JOIN appointment a ON a.appointment_id = pr.appointment_id
  6  	    JOIN patient     p ON p.patient_id	   = a.patient_id
  7  GROUP  BY pr.appointment_id, p.name
  8  ORDER  BY pr.appointment_id;

