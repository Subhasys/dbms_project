SQL> -- ---------------------------------------------------------------------
SQL> -- Q21. SQL FUNCTIONS (string): UPPER, LENGTH, SUBSTR, INSTR, ||
SQL> -- ---------------------------------------------------------------------
SQL> SELECT UPPER(name) 			     AS doctor_name,
  2  	    LENGTH(name)			     AS name_length,
  3  	    SUBSTR(email, 1, INSTR(email, '@') - 1)  AS username,
  4  	    SUBSTR(email, INSTR(email, '@') + 1)     AS domain,
  5  	    'XXXXXX' || SUBSTR(phone, -4)	     AS masked_phone
  6  FROM   doctor
  7  ORDER  BY name;

