SQL> -- ---------------------------------------------------------------------
SQL> -- Q11. HAVING: patients who registered more than one phone number
SQL> --      (multivalued attribute)
SQL> -- ---------------------------------------------------------------------
SQL> SELECT p.patient_id, p.name AS patient_name, COUNT(*) AS phone_count
  2  FROM   patient p
  3  	    JOIN patient_phone ph ON ph.patient_id = p.patient_id
  4  GROUP  BY p.patient_id, p.name
  5  HAVING COUNT(*) > 1;

