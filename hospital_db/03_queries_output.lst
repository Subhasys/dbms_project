SQL> -- ---------------------------------------------------------------------
SQL> -- Q24. ANALYTIC FUNCTION: rank patients by total amount billed
SQL> -- ---------------------------------------------------------------------
SQL> SELECT *
  2  FROM  (SELECT p.name AS patient_name,
  3  		   SUM(b.total_amount) AS total_billed,
  4  		   RANK() OVER (ORDER BY SUM(b.total_amount) DESC) AS bill_rank
  5  	    FROM   v_bill_total b
  6  		   JOIN patient p ON p.patient_id = b.patient_id
  7  	    GROUP  BY p.name)
  8  WHERE bill_rank <= 5
  9  ORDER BY bill_rank;

