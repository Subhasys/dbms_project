SQL> -- ---------------------------------------------------------------------
SQL> -- Q7. GROUP BY + HAVING: doctors who have two or more appointments
SQL> -- ---------------------------------------------------------------------
SQL> SELECT d.doctor_id, d.name AS doctor_name, d.specialization,
  2  	    COUNT(*) AS total_appointments
  3  FROM   appointment a
  4  	    JOIN doctor d ON d.doctor_id = a.doctor_id
  5  GROUP  BY d.doctor_id, d.name, d.specialization
  6  HAVING COUNT(*) >= 2
  7  ORDER  BY total_appointments DESC, d.name;

