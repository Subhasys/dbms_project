SQL> -- ---------------------------------------------------------------------
SQL> -- Q5. JOIN (4 tables): prescription lines with the cost of each line
SQL> -- ---------------------------------------------------------------------
SQL> SELECT pr.appointment_id, p.name AS patient_name, m.medicine_name,
  2  	    pr.dosage, pr.quantity, m.unit_price,
  3  	    pr.quantity * m.unit_price AS line_cost
  4  FROM   prescribes pr
  5  	    JOIN medicine    m ON m.medicine_id    = pr.medicine_id
  6  	    JOIN appointment a ON a.appointment_id = pr.appointment_id
  7  	    JOIN patient     p ON p.patient_id	   = a.patient_id
  8  ORDER  BY pr.appointment_id, m.medicine_name;

