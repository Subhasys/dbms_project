SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- Q8. AGGREGATE + OUTER JOIN: doctors and fees per department
SQL> -- ---------------------------------------------------------------------
SQL> SELECT dep.dept_name,
  2  	    COUNT(doc.doctor_id)		       AS doctors,
  3  	    NVL(ROUND(AVG(doc.consultation_fee), 2), 0) AS avg_fee,
  4  	    NVL(MAX(doc.consultation_fee), 0)	       AS max_fee
  5  FROM   department dep
  6  	    LEFT JOIN doctor doc ON doc.dept_id = dep.dept_id
  7  GROUP  BY dep.dept_name
  8  ORDER  BY doctors DESC, dep.dept_name;

