SQL> -- ---------------------------------------------------------------------
SQL> -- Q23. SQL FUNCTIONS (TO_CHAR) + GROUP BY: appointments per month
SQL> -- ---------------------------------------------------------------------
SQL> SELECT TO_CHAR(appt_date, 'YYYY-MM')			   AS appt_month,
  2  	    COUNT(*)						   AS total,
  3  	    SUM(CASE WHEN status = 'Completed' THEN 1 ELSE 0 END)  AS completed,
  4  	    SUM(CASE WHEN status = 'Scheduled' THEN 1 ELSE 0 END)  AS scheduled,
  5  	    SUM(CASE WHEN status = 'Cancelled' THEN 1 ELSE 0 END)  AS cancelled
  6  FROM   appointment
  7  GROUP  BY TO_CHAR(appt_date, 'YYYY-MM')
  8  ORDER  BY appt_month;

