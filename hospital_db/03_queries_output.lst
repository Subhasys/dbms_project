SQL> -- ---------------------------------------------------------------------
SQL> -- Q6. JOIN (view): patients currently admitted (not yet discharged)
SQL> --     with days stayed so far and the room charge accumulated
SQL> -- ---------------------------------------------------------------------
SQL> SELECT a.admission_id, p.name AS patient_name, r.room_no, r.room_type,
  2  	    a.admit_date, s.stay_days,
  3  	    s.stay_days * r.charge_per_day AS charge_so_far
  4  FROM   admission a
  5  	    JOIN patient	  p ON p.patient_id   = a.patient_id
  6  	    JOIN room		  r ON r.room_no      = a.room_no
  7  	    JOIN v_admission_stay s ON s.admission_id = a.admission_id
  8  WHERE  a.discharge_date IS NULL
  9  ORDER  BY a.admit_date;

ADMISSION_ID PATIENT_NAME              ROOM_NO ROOM_TYPE    ADMIT_DAT  STAY_DAYS CHARGE_SO_FAR                                                                                                          
