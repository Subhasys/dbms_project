SQL> 
SQL> -- ---------------------------------------------------------------------
SQL> -- Q12. AGGREGATE with CASE: room availability by room type
SQL> -- ---------------------------------------------------------------------
SQL> SELECT room_type,
  2  	    MIN(charge_per_day) 				 AS daily_charge,
  3  	    COUNT(*)						 AS total_rooms,
  4  	    SUM(CASE WHEN status = 'Available'	 THEN 1 ELSE 0 END) AS available,
  5  	    SUM(CASE WHEN status = 'Occupied'	 THEN 1 ELSE 0 END) AS occupied,
  6  	    SUM(CASE WHEN status = 'Maintenance' THEN 1 ELSE 0 END) AS maintenance
  7  FROM   room
  8  GROUP  BY room_type
  9  ORDER  BY daily_charge;

ROOM_TYPE    DAILY_CHARGE TOTAL_ROOMS  AVAILABLE   OCCUPIED MAINTENANCE                                                                                                                                 
