SQL> -- ---------------------------------------------------------------------
SQL> -- Q19. NESTED (correlated scalar subquery): last appointment date
SQL> --      and number of visits for every patient
SQL> -- ---------------------------------------------------------------------
SQL> SELECT p.patient_id, p.name AS patient_name,
  2  	    (SELECT MAX(a.appt_date)
  3  	     FROM   appointment a
  4  	     WHERE  a.patient_id = p.patient_id) AS last_visit,
  5  	    (SELECT COUNT(*)
  6  	     FROM   appointment a
  7  	     WHERE  a.patient_id = p.patient_id) AS visits
  8  FROM   patient p
  9  ORDER  BY last_visit DESC;

